# Caddy edge for the all-in-one image (docker/Dockerfile.aio). Same route
# table as the split-stack docker/Caddyfile, but every backend is loopback in
# this same container. No Cloudflare trusted_proxies block — the AIO is aimed
# at LAN / behind whatever proxy the operator already runs.
{
	auto_https off
}

# :8080, not :80 — a port below 1024 needs root, and the station can run as an
# ordinary user (PUID/PGID, see PUID.md). The compose file publishes it.
:8080 {
	# Icecast mounts. Opus/FLAC/AAC are off by default but must be listed or
	# they fall through to the catch-all and 404. flush_interval -1 keeps the
	# never-ending audio body live.
	@streams path /stream.mp3 /stream.opus /stream.flac /stream.aac
	handle @streams {
		reverse_proxy 127.0.0.1:7702 {
			flush_interval -1
			transport http {
				read_buffer 16KB
				response_header_timeout 30s
				dial_timeout 5s
			}
		}
	}

	# HLS — the default listener transport. Liquidsoap writes segments and a
	# rolling playlist into the state dir; this serves that directory directly.
	# The playlist must not be cached: it is rewritten every segment.
	handle /hls/* {
		header {
			Access-Control-Allow-Origin *
			Cache-Control "no-cache"
		}
		# Caddy guesses the type from the extension, and `.ts` collides with
		# TypeScript — it served segments as text/vnd.trolltech.linguist. Most
		# players sniff the bytes and cope; a strict one or a CDN in front does
		# not, so state it.
		@hls_segment path *.ts
		header @hls_segment Content-Type video/mp2t
		# An HLS listener holds no socket, so Icecast cannot see them — the only
		# trace they leave is re-fetching the media playlist once per segment
		# while they play. Routing just those requests into their own access log
		# is what broadcast/hls-listeners.ts counts. SEGMENTS ARE NOT LOGGED:
		# they are 4x the volume and say nothing the playlist poll doesn't.
		@hls_playlist path *.m3u8
		log_name @hls_playlist hls_access
		# Same class of bug as the `.ts` line above, one extension over, and this
		# one reached listeners: Caddy guessed the playlist type from the Debian
		# image's system table and served `audio/x-mpegurl` — the legacy type for
		# an M3U FILE LIST. AVFoundation decides from the Content-Type whether a
		# URL is a live HLS stream or a plain playlist, so Apple clients were
		# left guessing: sometimes playback, sometimes "connecting" forever, on
		# the same device minutes apart. This is the type Apple specifies.
		header @hls_playlist Content-Type application/vnd.apple.mpegurl
		root * /var/sub-wave
		file_server
	}

	# Icecast's URL-auth callback — NOT reachable from the internet (password
	# oracle otherwise; icecast calls the controller on loopback directly).
	# Kept in lockstep with docker/Caddyfile.
	handle /api/listener-auth {
		respond 404
	}

	# The AzuraCast-shaped now-playing payload, served from a FILE.
	#
	# This is the one endpoint radio clients hammer — Shelv polls it every 3s per
	# device — and the controller is a single Node event loop shared with the DJ,
	# the tagger and TTS. Routed through that loop, a poll waits behind whatever
	# it is doing, the client times out and shows "connecting" with no title and
	# no cover while the audio plays on. The controller therefore renders the
	# payload to nowplaying-static.json once a second and this serves that,
	# exactly as AzuraCast's nginx does ("so nginx can serve it without calling
	# the PHP stack at all"). A busy — or dead — controller still answers.
	#
	# Only the bare endpoint: /api/nowplaying/<x>/art and everything else stay on
	# the controller. No SITE_URL means no file, and then this falls through to
	# the route, which is the pre-existing behaviour.
	@nowplaying path_regexp nowplaying ^/api/nowplaying/[^/]+/?$
	handle @nowplaying {
		root * /var/sub-wave
		@nowplaying_file file /nowplaying-static.json
		handle @nowplaying_file {
			header {
				Access-Control-Allow-Origin *
				# One second, stated explicitly. A proxy in front with caching of
				# its own (the operator's nginx, a CDN) otherwise invents its own
				# freshness rule, and a stale now-playing reads to a client as a
				# frozen title or no metadata at all.
				Cache-Control "max-age=1, must-revalidate"
			}
			rewrite * /nowplaying-static.json
			file_server
		}
		handle {
			uri strip_prefix /api
			reverse_proxy 127.0.0.1:7701
		}
	}

	# Controller REST API (prefix stripped so its routes stay at root).
	handle_path /api/* {
		reverse_proxy 127.0.0.1:7701
	}

	# One-paste tune-in files — served by the controller at its root (NOT under
	# /api), so plain handle, no path stripping.
	@listen path /listen.pls /listen.m3u
	handle @listen {
		reverse_proxy 127.0.0.1:7701
	}

	# Everything else → Next.js web UI.
	handle {
		reverse_proxy 127.0.0.1:7700
	}

	# Don't gzip the already-compressed live audio mounts.
	@compressible not path /stream.mp3 /stream.opus /stream.flac /stream.aac /hls/*
	encode @compressible gzip zstd

	log {
		output stdout
		format console
	}

	# HLS playlist polls, and only those (`no_hostname` keeps every other request
	# on the default logger above, which also keeps the 4s-per-listener chatter
	# out of the container log). JSON because broadcast/hls-listeners.ts parses
	# it: `ts`, `request.client_ip`, `request.uri`, `request.headers.User-Agent`.
	#
	# Rolling is bounded and UNCOMPRESSED on purpose — the reader walks back into
	# the most recent rolled file when the current one doesn't reach far enough
	# back, and a .gz would make that read a decompressor.
	log hls_access {
		output file /var/sub-wave/hls-access.log {
			mode 644
			roll_size 4mb
			roll_keep 2
			roll_keep_for 24h
			roll_uncompressed
		}
		format json
		no_hostname
	}
}
